{
    "name": "prestashopheaven/runtime-kit",
    "description": "The base of every PrestaHaven module: the ModuleBase trait, the module definition, installer, uninstaller, SQL migrations, upgrade helpers, translated tabs, the configuration page and the PrestaHaven bar. Successor of module-kit.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "George van Engers",
            "email": "vanengers@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.1"
    },
    "autoload": {
        "psr-4": {
            "PrestaShopHeaven\\Runtime\\Kit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PrestaShopHeaven\\Runtime\\Kit\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        },
        "prestashopheaven": {
            "kind": "runtime",
            "use-when": "Every module: install and uninstall (hooks, configuration, tabs, data folders, SQL migrations) in all shops, upgrade scripts, translated back-office tabs, the Configure button that opens the module page, and the PrestaHaven bar with the updater notice and the Help button.",
            "keywords": [
                "module",
                "install",
                "uninstall",
                "upgrade",
                "migration",
                "sql",
                "hooks",
                "configuration",
                "tabs",
                "menu",
                "configure button",
                "updater notice",
                "help button",
                "module definition"
            ],
            "phpstan-paths": [
                "src",
                "tests/phpstan/fixtures"
            ],
            "integration-tested": [
                "src/Install/Installer.php",
                "src/Install/Migrator.php",
                "src/Install/Uninstaller.php",
                "src/ModuleBase.php",
                "src/Shop/ShopScope.php",
                "src/Upgrade/Upgrade.php"
            ]
        }
    }
}
